{
  "name": "sard",
  "version": "0.1.0",
  "private": true,
  "description": "Sard 是基于 Vue3 的 Web 移动端 UI 组件库",
  "license": "MIT",
  "author": "wuzhitao",
  "type": "module",
  "scripts": {
    "dev": "tsx ./scripts/dev.ts",
    "tag": "tsx ./scripts/tag.ts",
    "changelog": "tsx ./scripts/changelog.ts",
    "build:icons": "tsx ./scripts/build-icons.ts",
    "build:sard": "tsx ./scripts/build-sard.ts",
    "build:all": "pnpm run build:icons && pnpm run build:sard",
    "publish:icons": "tsx ./scripts/publish-icons.ts",
    "publish:sard": "tsx ./scripts/publish-sard.ts",
    "push": "git push origin && git push gitee && git push origin --tags --force && git push gitee --tags --force",
    "build:site": "tsx ./scripts/build-site.ts",
    "build": "vite build",
    "deploy": "tsx ./scripts/deploy.ts",
    "preview": "tsx ./scripts/preview.ts",
    "test": "run-s test:type test:lint test:unit",
    "test:type": "vue-tsc --noEmit -p tsconfig.vitest.json",
    "test:lint": "oxlint",
    "test:unit": "vitest run",
    "prepare": "husky install",
    "new-component": "tsx ./scripts/new-component.ts",
    "nc": "npm run new-component",
    "new-sub-component": "tsx ./scripts/new-sub-component.ts",
    "nsc": "npm run new-sub-component",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "commit": "commit"
  },
  "dependencies": {
    "@sard/icons": "workspace:*",
    "@vue/babel-plugin-jsx": "^3.0.0",
    "pinia": "^3.0.4",
    "region-data": "^1.2.3",
    "sard": "workspace:*",
    "tel-area-code": "^1.1.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@commitlint/prompt-cli": "^17.8.1",
    "@dcloudio/types": "^3.4.32",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/gh-pages": "^6.1.0",
    "@types/inquirer": "^9.0.7",
    "@types/jsdom": "^28.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-legacy": "^8.2.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.1",
    "consola": "^3.2.3",
    "conventional-changelog": "^7.2.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-playwright": "^2.10.1",
    "eslint-plugin-vue": "~10.8.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "ignore": "^7.0.6",
    "inquirer": "^9.3.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "lint-staged": "^13.3.0",
    "listr2": "^10.2.2",
    "lodash-es": "^4.17.21",
    "npm-run-all2": "^8.0.4",
    "oxc-transform": "^0.138.0",
    "oxfmt": "^0.45.0",
    "oxlint": "~1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "postcss": "^8.5.25",
    "postcss-preset-env": "^11.3.2",
    "rolldown": "^1.1.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.101.0",
    "string-replace-async": "^3.0.2",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitepress": "2.0.0-alpha.17",
    "vitepress-plugin-group-icons": "^1.7.5",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.3.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,vue}": "npm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.25"
    }
  }
}
